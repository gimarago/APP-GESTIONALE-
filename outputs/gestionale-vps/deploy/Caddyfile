{
    email {$ACME_EMAIL}
}

{$OFFICINA_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    reverse_proxy app:8080 {
        # The normal public host never attests an SdI client identity.
        header_up -X-Sdi-Gateway-Token
        header_up -X-Sdi-Peer-Fingerprint
        header_up -X-Sdi-Gateway-Host
        # Do not buffer the event stream that announces saved changes.
        flush_interval -1
    }
}
