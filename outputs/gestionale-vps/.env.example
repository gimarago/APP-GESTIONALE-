# Copy to .env on the VPS; enter a real DNS name (no https:// or path).
OFFICINA_DOMAIN=gestionale.example.com
ACME_EMAIL=amministratore@example.com
# Must match exactly the public origin, with https:// and no trailing slash.
OFFICINA_ORIGIN=https://gestionale.example.com
# Optional immutable image pin for production after testing a build.
CADDY_IMAGE=caddy:2-alpine

# Customer PDF email (reports and quotes). The sender in Settings must match
# SMTP_FROM (or SMTP_USER). The service selected in Settings picks its host.
# For Gmail, use an App Password, not the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER. Gmail may replace unapproved From aliases.
SMTP_FROM=

# Independent password-recovery sender. Leave these blank to use the legacy
# SMTP_* settings above. To separate recovery mail, set all five values.
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=
RECOVERY_SMTP_USER=
RECOVERY_SMTP_PASSWORD=
RECOVERY_SMTP_FROM=

# Optional Legalmail PEC collector: only enable after checking that this
# mailbox actually receives SdI invoices for SHOP_VAT. PEC_USER may be the
# InfoCert User ID rather than the full PEC address. Use a dedicated Legalmail
# Application Password when available; this is separate from Gmail SMTP.
# Keep credentials secret.
SHOP_VAT=
PEC_HOST=mbox.cert.legalmail.it
PEC_PORT=993
PEC_MAILBOX=INBOX
PEC_USER=
PEC_APP_PASSWORD=

# Optional DIRECT SdICoop channel. Disabled in the normal compose.yaml.
# Read SDI-DIRETTO.md. A domain alone is NOT an accredited channel.
# Use compose.sdi.yaml only once certificates and agreement are available.
SDI_ENABLED=false
SDI_ENVIRONMENT=test
SDI_PRODUCTION_APPROVED=false
SDI_ACCREDITATION_REFERENCE=
SDI_DOMAIN=
# Explicit values from the agreement for the selected environment; no defaults.
SDI_ENDPOINT=
SDI_ENDPOINT_HOST=
# SHA-256 leaf fingerprints of the approved SdI callers, comma separated.
SDI_PEER_FINGERPRINTS=
# Generate with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
SDI_GATEWAY_TOKEN=
# Absolute directory OUTSIDE the code/release with readonly certificate mounts.
SDI_SECRETS_DIR=/opt/officina-secrets/sdi-test
SDI_TIMEOUT_MS=30000
