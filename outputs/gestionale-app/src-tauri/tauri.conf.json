{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Officina M.A. Gomme",
  "version": "1.0.3",
  "identifier": "it.magomme.officina",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        "launcher",
        "workshop",
        "android-back",
        "updates"
      ]
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Il gestionale della tua officina",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian"
        ],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRjE3MzVBOEM1QzBCRkIKUldUN0MxeU1XblB4MmhiQVA5Y0FnS2ZhYXcyb2JVUDErd3I0Q1kyOEVHeVNSZWw0cTJDc3QySnYK",
      "endpoints": [
        "https://api.magomme.it/app-updates/windows-x86_64/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
